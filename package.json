{
  "name": "wisht",
  "private": true,
  "version": "0.1.0",
  "workspaces": [
    "web",
    "api"
  ],
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "build": "npm run build -w api && npm run build -w web",
    "test": "npm run test -w api",
    "test:db": "bash scripts/test-foundation-db.sh",
    "test:local-browser": "node scripts/test-local-browser.mjs && node scripts/test-local-scenarios.mjs",
    "test:local-jinns": "node scripts/test-local-jinns.mjs",
    "test:local-i18n": "node scripts/test-local-i18n.mjs",
    "test:local-first-value": "node scripts/test-local-first-value.mjs",
    "typecheck": "npm run typecheck -w api && npm run typecheck -w web"
  },
  "devDependencies": {
    "@netlify/functions": "^4.0.0",
    "concurrently": "^9.2.0",
    "playwright-core": "^1.65.1",
    "typescript": "^5.9.3"
  }
}
