# Server-only secrets. Set in Netlify Environment variables (Functions scope).
# Recommended: start with DeepSeek; deterministic intents use no LLM calls.
LLM_PROVIDER=deepseek
DEEPSEEK_API_KEY=
LLM_MODEL=deepseek-flash

# Alternative: OpenAI (set LLM_PROVIDER=openai and OPENAI_API_KEY).
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Public Vite build variables: safe to expose to client, but configure per environment.
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=
